# RevenueCat public SDK keys (Project settings > API keys in RevenueCat).
# Copy to .env.local for local builds; set them as EAS environment variables for store builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog: the production project key is built in (src/config/analytics.ts).
# Set a different phc_ key here to send to another project, or "off" to disable.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
